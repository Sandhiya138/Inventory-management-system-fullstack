# ==============================================================================
# VelvetStock Backend Environment Configuration
# ==============================================================================

# Server Port (Render and cloud hosts provide PORT dynamically, e.g. 10000)
PORT=8080

# Managed MySQL Database Connection
# Option 1: Individual connection parameters (standard)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory_management
DB_USERNAME=root
DB_PASSWORD=1234
DB_SSL=false

# Option 2: Full JDBC URL (if your managed MySQL provider supplies a single connection string)
# Example for cloud: jdbc:mysql://db-instance.render.com:3306/inventory_management?useSSL=true&serverTimezone=Asia/Kolkata
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/inventory_management?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true

# CORS Allowed Origins
# For production, set to your deployed Vercel domain:
# Example: FRONTEND_URL=https://velvetstock.vercel.app
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# JWT Secret Key (Generate a secure 256-bit base64 key for production)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970337336763979244226452948404D6351
JWT_EXPIRATION_MS=86400000

# Demo Data Seeding
# Local Development: true (seeds demo users, products, categories)
# Production: false (prevents demo data from populating a real production database)
SEED_DEMO_DATA=true
