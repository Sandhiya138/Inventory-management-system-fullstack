# VelvetStock Frontend Environment Configuration

# Local Development (leave empty or set to localhost):
# When empty, Vite development proxy automatically handles /api requests to http://localhost:8080
VITE_API_URL=http://localhost:8080

# Production Deployment (Vercel):
# Set this in your Vercel Project Settings > Environment Variables
# Example: VITE_API_URL=https://velvetstock-api.onrender.com
# VITE_API_URL=https://<your-deployed-spring-boot-backend-url>
